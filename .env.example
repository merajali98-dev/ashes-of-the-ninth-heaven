# Copy to .env for local development. Every setting is optional: with none of them the game runs on the
# practice market, and sign-in shows its code on screen instead of emailing it.

# Google sign-in: a Web client from Google Auth Platform with http://localhost and http://localhost:4173 as
# JavaScript origins. Public by design; no client secret is used.
GOOGLE_CLIENT_ID=

# Real sign-in emails (otherwise the code and link are shown on screen). Either SMTP, e.g. Gmail with an app password
# (Google Account → Security → 2-Step Verification → App passwords), or Resend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
ASHES_MAIL_FROM=

# The public address when hosted (used in emailed links and to mark cookies Secure), e.g. https://ashes.example.com
ASHES_PUBLIC_URL=

# Testnet keys for the ledger. Locally they are read from ~/.near-credentials/testnet/<account>.json instead.
# NEAR_KEY_ASHES_NINTH_TESTNET=ed25519:...
# NEAR_KEY_ASHES_RELAY_TESTNET=ed25519:...
# NEAR_KEY_MINTER_ASHES_NINTH_TESTNET=ed25519:...
# ASHES_CHAIN=off   # force the practice market even when keys are present

# Hosting: 32-byte base64 secrets (locally they are generated into server/data/secrets.json).
# ASHES_MASTER_KEY=
# ASHES_HMAC_KEY=
